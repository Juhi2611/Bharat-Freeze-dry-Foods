# BFF frontend environment variables
# Copy to `.env` / `.env.local` as needed. Never commit production secrets.

# --- API (F4) ---
# Full backend API base including the `/api/v1` prefix.
# MUST be set for staging/production builds — the localhost default is for local dev only.
# Prefer localhost over 127.0.0.1 so refresh cookies stay same-site with the SPA.
VITE_API_BASE_URL=http://localhost:8000/api/v1
