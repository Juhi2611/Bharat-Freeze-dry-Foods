# bff-main environment variables
# VITE_LIGHT_SITE_URL — URL of the light/bff-site site
# Dev default: http://localhost:3000 (Next.js dev server)
# Production: update this to your deployed bff-site domain

VITE_LIGHT_SITE_URL=http://localhost:3000

# Must use localhost (not 127.0.0.1) so admin session survives refresh via cookie.
VITE_API_BASE_URL=http://localhost:8000/api/v1
