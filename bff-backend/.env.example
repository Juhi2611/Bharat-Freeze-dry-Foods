# BFF backend environment variables
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Required for production (DEBUG=False):
#   DEBUG=False
#   SECRET_KEY=<long random string>
#   ALLOWED_HOSTS=api.yourdomain.com
#   CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com


# --- CSRF (F5) — must list the same frontend origin(s) as CORS when SPA and API differ by host/port
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082,http://localhost:3000,http://127.0.0.1:3000

# Refresh cookie flags (F5). Secure defaults to True when DEBUG=False.
# REFRESH_COOKIE_SECURE=False
# REFRESH_COOKIE_SAMESITE=Lax

# --- Core security (B2) ---
DEBUG=True
SECRET_KEY=django-insecure-local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (B6) — frontend origin(s) only; no wildcards ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082,http://localhost:3000,http://127.0.0.1:3000

# --- Database (MySQL — required) ---
# Create DB first: CREATE DATABASE bff CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:Gargi@2275@127.0.0.1:3306/bff

# --- Payments ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# --- Email ---
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@example.com

# --- Ops ---
# ABANDONED_ORDER_TIMEOUT_MINUTES=45
